{
  "name": "chorusgate",
  "version": "1.0.0",
  "description": "ChorusGate - local coordination boundary for digital-employee runtimes (V10 observation slice)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/test-env.mjs --test --test-timeout=30000 --test-force-exit tests/*.test.ts",
    "v10:web": "tsx src/v10/web-server.ts"
  },
  "keywords": [
    "agent",
    "gateway",
    "runtime",
    "coordination",
    "v10"
  ],
  "license": "MIT",
  "dependencies": {
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.0"
  }
}
